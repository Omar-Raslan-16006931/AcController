# Supabase project — service role key, NEVER exposed to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed for Supabase projects still on the legacy HS256 JWT secret.
# Projects on the current asymmetric signing-keys system don't need this at
# all — see app/dependencies.py. Leave unset unless auth errors say otherwise.
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed CORS origins (your Vercel URL + localhost).
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# --- Shortcuts / personal-automation auth (see app/dependencies.py) --------
# Leave both unset to disable /api/shortcuts entirely.
SHORTCUT_API_KEY=
SHORTCUT_USER_ID=

# --- IR hardware -------------------------------------------------------------
# GPIO pin, carrier frequency, and duty cycle are not configurable here: the
# production CarrierAC library derives its IR timing directly from a
# captured base.txt file, not from these parameters.
IR_DEVICE=/dev/lirc0

# Where generated IR pulse files and the last-known AC state are written.
IR_FILES_DIR=./ir_files
STATE_FILE_PATH=./ac_state.json

# Set to "1" to skip the real ir-ctl subprocess call (packets are still
# generated, just not sent). Set to "0" once the Pi + IR hardware are
# wired up and ir-ctl is confirmed working.
SIMULATE_IR=1

SCHEDULER_POLL_SECONDS=20

# --- AC brute-force detector (see docs/AC_DETECT.md) ------------------------
DETECTED_AC_FILE_PATH=./detected_ac.json

# --- Manual IR learning (see docs/AC_LEARN.md) -------------------------------
# Separate device from IR_DEVICE above -- that's the TX-only gpio-ir-tx lirc
# device used for sending. Learning RECEIVES, which needs its own IR receiver
# module (e.g. a TSOP38238) wired to a different GPIO pin with the plain
# gpio-ir overlay. Leave as-is until that hardware is wired; SIMULATE_IR=1
# lets the whole learn flow be exercised without it.
IR_RX_DEVICE=/dev/lirc1
LEARNED_SIGNALS_DIR=./learned_signals

# --- WiFi hotspot fallback (see docs/WIFI_FALLBACK.md) ----------------------
# Read by BOTH this app (read-only checks/writes) AND
# backend/scripts/wifi_watchdog.py, which runs as its OWN root systemd
# service, separate from this one -- the FastAPI app never runs nmcli
# itself, it only reads/writes these three files. Change the paths only if
# you also update ac-controller-wifi-watchdog.service's WorkingDirectory.
WIFI_AP_MODE_FLAG_PATH=/home/pi/AcController/backend/.wifi_ap_mode
WIFI_PENDING_PATH=/home/pi/AcController/backend/.wifi_pending.json
WIFI_STATUS_PATH=/home/pi/AcController/backend/.wifi_last_result.json

# The following two are read directly by wifi_watchdog.py (NOT by this
# FastAPI app / pydantic Settings) from this same .env file. Password must
# be 8+ characters (WPA2-PSK minimum) or `nmcli device wifi hotspot` fails.
WIFI_AP_SSID=AcController-Setup
WIFI_AP_PASSWORD=123456789
WIFI_INTERFACE=wlan0
