{
  "name": "ac-controller-desktop",
  "productName": "AC Controller",
  "version": "1.0.0",
  "description": "Windows tray app for the AC Controller (Raspberry Pi + IR).",
  "main": "main.js",
  "private": true,
  "author": "Omar",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.omar.accontroller.desktop",
    "productName": "AC Controller",
    "files": ["main.js", "preload.js", "config.js", "renderer/**", "assets/**"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "AC-Controller-Setup.${ext}"
    },
    "portable": {
      "artifactName": "AC-Controller-Portable.${ext}"
    }
  }
}
